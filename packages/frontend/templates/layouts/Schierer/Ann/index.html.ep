% layout 'default';
% title 'Ann\'s Poetry';

<div class="container">
  <div class="alert alert-info">
    <p><strong>Note:</strong> This site represents a partial recovery of a previous site that was lost in server crash.</p>
  </div>


  <div class="poem-list">
    % if (@$poems) {
      <ul>
        % foreach my $poem (@$poems) {
          <li><a href="<%= $poem->{url} %>"><%= $poem->{name} %></a></li>
        % }
      </ul>
    % } else {
      <p>No poems found.</p>
    % }
  </div>
</div>
