<!DOCTYPE html>
<html lang="en" class="spectrum spectrum--dark spectrum--medium spectrum-Typography">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Micro+5&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/~luke/node_modules/@spectrum-css/tokens/dist/css/index.css" />
  <link rel="stylesheet" href="/~luke/node_modules/@spectrum-css/icon/index.css" />
  <link rel="stylesheet" href="/~luke/node_modules/@spectrum-css/page/index.css" />
  <link rel="stylesheet" href="/~luke/node_modules/@spectrum-css/typography/index.css" />
  <link rel="stylesheet" href="/~luke/node_modules/@spectrum-css/link/index.css" />
  <link rel="stylesheet" href="/~luke/global.css" />
  <link rel="stylesheet" href="/~luke/log/style.css" />
  <link rel="stylesheet" href="/~luke/log/local.css" />
  <script src="/~luke/node_modules/iconify-icon/dist/iconify-icon.min.js" type="module"></script>
  <script
      src="/~luke/components/license.js"
      type="module"
      data-gwd-opt="static"
    ></script>
    <script
      src="/~luke/components/tags.js"
      type="module"
      data-gwd-opt="static"
    ></script>

    <script src="/~luke/components/SideBar.js" type="module"></script>
    <script
      src="/~luke/components/LastEdit.js"
      type="module"
      data-gwd-opt="static"
    ></script>

  <title><%= $title %></title>

  % if (stash('yaml_data') && exists stash('yaml_data')->{css}) {
    % foreach my $css_file (@{stash('yaml_data')->{css}}) {
      <link rel="stylesheet" href="<%= $css_file %>">
    % }
  % }
</head>
<body>
  <header>
    <div class="site-title-section">
      <a href='/' class="site-title spectrum-Link spectrum-Link--quiet spectrum-Link--secondary">
        <span class=" site-title spectrum-Heading spectrum-Heading--sizeXS">
          <img src="/~luke/assets/log/RandomUnfinishedThoughts.png" class="toplogo"/>
        </span>
      </a>
    </div>
    <div class=" right-group">
      <div class=" social-icons">
        <a href="https://github.com/lschierer/RUT">
          <iconify-icon icon="carbon:logo-github" width="32" height="32"></iconify-icon>
        </a>
      </div>
    </div>
  </header>

  <main>
    <%== $content %>
  </main>

  <footer id="footer" class="pagefooter" role="contentinfo">
      <div id="pageinfo">
        <div class="tags">
          <page-tags>${globalThis.page.data.tags}</page-tags>
        </div>
        <div id="backlinks">
          <backlinks-component>
            ${globalThis.page.data.links ?? ""}
          </backlinks-component>
        </div>
        <div class="pagedate">
          <last-edit>${globalThis.page.data.date}</last-edit>
        </div>
        <div class="pagecopyright">
          <span>
            <a
              id="pagecopyright"
              href="https://www.schierer.org/~luke/"
              title="Luke's Home Page"
              >
              <img
                src="/~luke/assets/owl.gif"
                class="bottomlogo"
                height="67"
                width="64"
                alt="This Page was created by Luke Schierer"
              />
            </a>
            <br />
            <br />
            Copyright © 2005-<%= (localtime)[5] + 1900 %> Luke Schierer.
          </span>
          <div class="pagelicense">
            <license-display></license-display>
          </div>
        </div>
      </div>
      <span class="greenwood"
        >This site was generated by
        <a href="https://greenwoodjs.dev/"
          ><img
            src="/~luke/assets/greenwood-logo-full.svg"
            alt="Greenwood"
            class="Greenwood" /></a
      ></span>
    </footer>


  % if (stash('yaml_data') && exists stash('yaml_data')->{js}) {
    % foreach my $js_file (@{stash('yaml_data')->{js}}) {
      <script src="<%= $js_file %>"></script>
    % }
  % }
</body>
</html>
