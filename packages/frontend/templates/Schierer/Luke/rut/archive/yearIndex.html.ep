<%# yearIndex.html.ep %>
% title "Archive for $year";

<div class="year-archive">
  <% if(stash('months')) { %>
    <% my $months = stash('months'); %>
    <div class="month-list">
      <% foreach my $month (1..12) { %>
        <div class="month-entry">
          <% my $month_str = sprintf("%02d", $month); %>
          <% if(exists $months->{$month_str}) { %>
            <a href="/~luke/log/archive/<%= $year %>/<%= $month_str %>/">
              <%= DateTime->new(year => $year, month => $month)->month_name %>
            </a>
          <% } else { %>
            <span>No Archive Available for <%= DateTime->new(year => $year, month => $month)->month_name %></span>
          <% } %>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="archive-navigation">
    <% my $now = DateTime->now(); %>
    <% my $previous_year = $year - 1; %>
    <% my $next_year = $year + 1; %>
    <% if ($previous_year >= 2005 ) { %>
      <a href="/~luke/log/archive/<%= $previous_year %>/" class="nav-link prev-year">
        &larr; <%= $previous_year %>
      </a>
    <% } %>

    <% if ($next_year <= $now->year()) { %>
      <a href="/~luke/log/archive/<%= $next_year %>/" class="nav-link next-year">
        <%= $next_year %> &rarr;
      </a>
    <% } %>
  </div>
</div>
