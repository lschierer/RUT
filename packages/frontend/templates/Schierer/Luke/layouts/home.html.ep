<!DOCTYPE html>
<html lang="en" class="">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= $title %></title>

  <link rel="stylesheet" href="/~luke/styles/global.css" />
  <link rel="stylesheet" href="/~luke/styles/home.css" />

  % if (stash('yaml_data') && exists stash('yaml_data')->{css}) {
    % foreach my $css_file (@{stash('yaml_data')->{css}}) {
      <link rel="stylesheet" href="<%= $css_file %>">
    % }
  % }
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y3WJYW9RQ1"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-Y3WJYW9RQ1');
  </script>
</head>
<body>
  <header>
    <img src="/~luke/assets/lukelogo.jpg" class="toplogo"/>
  </header>

  <main>
    <%== $content %>
  </main>

  <footer id="footer" class="pagefooter" role="contentinfo">
      <div id="pageinfo">
        <div class="pagecopyright">
          <span>
            <a
              id="pagecopyright"
              href="/~luke/"
              title="Luke's Home Page"
              >
              <img
                src="/~luke/assets/owl.gif"
                class="bottomlogo"
                height="67"
                width="64"
                alt="This Page was created by Luke Schierer"
              />
            </a>
          </span>
          <span>
            <br />
            <br />
            Copyright © <%= (localtime)[5] + 1900 %> Luke Schierer.
          </span>

        </div>
      </div>

    </footer>

  % if (stash('yaml_data') && exists stash('yaml_data')->{js}) {
    % foreach my $js_file (@{stash('yaml_data')->{js}}) {
      <script src="<%= $js_file %>"></script>
    % }
  % }
</body>
</html>
