{
  "name": "random-unfinished-thoughts",
  "description": "random-unfinished-thoughts following open-wc recommendations",
  "license": "ISC",
  "author": "Luke Schierer",
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "lint": "NODE_OPTIONS='--experimental-strip-types' eslint --flag unstable_native_nodejs_ts_config --ext .ts,.html . --ignore-path .gitignore && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint --ext .ts,.html . --fix --ignore-path .gitignore && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "build": "rimraf dist && tsc && rollup -c rollup.config.js ",
    "start:build": "web-dev-server --root-dir dist",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"rollup -w -c rollup.config.js\"",
    "check": "NODE_OPTIONS='--experimental-strip-types'  npm eslint --flag unstable_native_nodejs_ts_config ."
  },
  "dependencies": {
    "glob": "^11.0.1",
    "lit": "^3.2.1",
    "log4js": "^6.9.1",
    "micromark": "^4.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-class-names": "^2.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-alerts": "^0.0.1",
    "remark-class-names": "^0.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/format": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@eslint/js": "^9.24.0",
    "@open-wc/dev-server-hmr": "^0.2.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/dev-server-import-maps": "^0.2.1",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/rollup-plugin-html": "^2.3.0",
    "@web/rollup-plugin-import-meta-assets": "^2.2.1",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "check": "^1.0.0",
    "concurrently": "^9.1.2",
    "deepmerge": "^4.3.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-x": "^4.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rollup": "catalog:",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-workbox": "^8.1.2",
    "tslib": "catalog:",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
