{
  "name": "random-unfinished-thoughts",
  "description": "random-unfinished-thoughts following open-wc recommendations",
  "license": "ISC",
  "author": "Luke Schierer",
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "lint": "NODE_OPTIONS='--experimental-strip-types' eslint --flag unstable_native_nodejs_ts_config --ext .ts,.html . --ignore-path .gitignore && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint --ext .ts,.html . --fix --ignore-path .gitignore && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "build": "rimraf dist && tsc && rollup -c rollup.config.js ",
    "start:build": "web-dev-server --root-dir dist",
    "start": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"rollup -w -c rollup.config.js\"",
    "check": "NODE_OPTIONS='--experimental-strip-types'  npm eslint --flag unstable_native_nodejs_ts_config ."
  },
  "dependencies": {
    "glob": "catalog:",
    "lit": "catalog:",
    "log4js": "^6.9.1",
    "micromark": "^4.0.2",
    "rehype-autolink-headings": "catalog:",
    "rehype-class-names": "catalog:",
    "rehype-raw": "catalog:",
    "rehype-slug": "catalog:",
    "rehype-stringify": "catalog:",
    "remark": "catalog:",
    "remark-alerts": "catalog:",
    "remark-class-names": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@open-wc/dev-server-hmr": "^0.2.0",
    "@rollup/plugin-alias": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@rollup/plugin-image": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "@types/debug": "^4.1.12",
    "@types/mocha": "catalog:",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/dev-server-import-maps": "^0.2.1",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/rollup-plugin-html": "^2.3.0",
    "@web/rollup-plugin-import-meta-assets": "^2.2.1",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "concurrently": "catalog:",
    "deepmerge": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-esbuild": "catalog:",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-workbox": "catalog:",
    "tslib": "catalog:",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
